# Copy to .env and fill in. Never commit the filled-in file.

# --- API -------------------------------------------------------------------
# Required in production; the service refuses to start without them.
DESI_NEXUS_TOKEN_SECRET=
DESI_NEXUS_WEBHOOK_SECRET=

# PostgreSQL with PostGIS. On Supabase use the transaction pooler (port 6543)
# when the API runs serverless, and the direct port for a long-lived process.
DATABASE_URL=

# The connection the user-less paths use: the Stripe webhook and the
# auto-release sweep. Same database, different login -- row-level security
# exempts this role, so a leaked API password must not carry the exemption.
# Point it at desi_nexus_system (created by 004), never at the schema owner.
DATABASE_SYSTEM_URL=

# Shared rate-limit buckets. Per-pod buckets are not limits.
REDIS_URL=

# Address lookup. Unset, the fake geocoder invents plausible Texas coordinates,
# which is fine locally and refused in production. The US Census service needs
# no API key, so there is no credential here to leak or rotate.
GEOCODER_URL=https://geocoding.geo.census.gov/geocoder/locations/onelineaddress
# GEOCODER_TIMEOUT_MS=4000

# Stripe. Until these are set the fake gateway is used and no money moves.
STRIPE_API_KEY=
STRIPE_CONNECT_RETURN_URL=
STRIPE_CONNECT_REFRESH_URL=

# --- Web -------------------------------------------------------------------
API_URL=http://127.0.0.1:8080
